# Provided by the interview organizer. Never commit a real key.
OPENROUTER_API_KEY=
# OpenRouter API endpoint (OpenAI-compatible).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model (any OpenRouter model id). Default is cheap and reliable at JSON output.
LLM_MODEL=openai/gpt-4.1-mini
# openrouter (default) | mock  - mock needs no key and is what CI uses.
LLM_PROVIDER=openrouter
# fastembed (default, local ONNX model, free) | hash (no download at all, tests/CI).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Vector DB: set QDRANT_URL to use the docker-compose Qdrant service; leave it empty to use
# Qdrant's embedded mode under QDRANT_PATH (no daemon needed).
QDRANT_URL=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=orbitmesh_chunks
# Cache LLM replies on disk (data/llm_cache) so eval re-runs are free. 1 | 0
LLM_CACHE=1
# Log customer message text (PII) - development only. 1 | 0
LOG_CONTENT=0
LOG_LEVEL=INFO
